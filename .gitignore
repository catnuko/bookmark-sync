# 依赖
node_modules/
.pnpm-store/

# 构建产物（pnpm build 输出）
extension/
extension-firefox/
website/node_modules/

# TRAE IDE 内部产物
.trae-html-share-packages/

# Xcode / Safari 扩展编译产物
bookmark-sync/build/
xcuserdata/
.DS_Store

# 本地打包产物（pnpm package 输出）
/dist/

# Xcode Safari 扩展构建产物（由 scripts/post-build-safari.mjs 生成）
bookmark-sync/Shared (Extension)/Resources/assets/

# 临时上传图片
.uploads/

# Agent 运行时记忆（个人每日记忆不进 git；memory/ 为项目通用记忆库，专题复盘文档收录）
memory/memory/

# E2E 浏览器运行期 profile（Chromium 会在其中写 .fuse / SingletonLock 等）
e2e/.profiles/
e2e/.ff-profiles/
.e2e*
# E2E 本地通道产物（profile + 运行报告）
scripts/e2e/.profiles/
scripts/e2e/.reports/
# WorkBuddy agent workspace
.workbuddy/

# 安装包托管在 Supabase Storage（release.yml 上传），仓库不存 zip 二进制
website/public/downloads/
*.zip

# 商店提交凭证（publish-extension init 生成；CLI 会自动加载 cwd 下的它）
.env.submit

# 本地开发用的登录凭据（vite.config.js 的 define 注入，绝不入 git / 不进商店包）
.dev-creds.json

.codebuddy
# .claude 下只有项目级子代理定义入库，本地设置仍忽略
.claude/*
!.claude/agents/
