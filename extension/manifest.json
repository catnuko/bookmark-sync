{
  "manifest_version": 3,
  "name": "Bookmark Sync",
  "version": "1.0.0",
  "description": "通过自建服务器在 Chrome / Safari 间同步书签",
  "permissions": ["bookmarks", "storage", "alarms"],
  "host_permissions": ["http://*/*", "https://*/*"],
  "background": { "service_worker": "background.js", "type": "module" },
  "options_page": "options.html"
}
