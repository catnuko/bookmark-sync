{
  "name": "bookmark-sync",
  "private": true,
  "version": "2.7.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vite build && node scripts/post-build-safari.mjs",
    "build:firefox": "vite build && node scripts/build-firefox.mjs",
    "build:all": "node scripts/build-all.mjs",
    "package": "vite build && node scripts/build-firefox.mjs && node scripts/package-zips.mjs && node scripts/package-source.mjs",
    "package:source": "node scripts/package-source.mjs",
    "pricing-cover": "node scripts/make-pricing-cover.mjs",
    "preview": "vite preview",
    "test": "vitest run",
    "test:watch": "vitest",
    "e2e": "node scripts/e2e/run.mjs",
    "e2e:reset": "node scripts/e2e/run.mjs reset",
    "typecheck": "tsc --noEmit",
    "lint": "oxlint src/ scripts/e2e/ tests/ website/src/",
    "lint:fix": "oxlint --fix src/ scripts/e2e/ tests/ website/src/",
    "fmt": "oxfmt",
    "fmt:check": "oxfmt --check",
    "check": "npm run typecheck && npm run lint && npm run fmt:check && npm run test"
  },
  "dependencies": {
    "@supabase/supabase-js": "^2.116.0",
    "vue": "^3.5.42"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "@vitejs/plugin-vue": "^6.0.8",
    "fake-indexeddb": "^6.2.5",
    "oxfmt": "^0.68.0",
    "oxlint": "^1.83.0",
    "playwright": "^1.63.0",
    "typescript": "^5.6.0",
    "vite": "^8.2.2",
    "vitest": "^3.0.0"
  }
}
