# E2E 配置模板 —— 复制到 .workbuddy/e2e.env（该目录已被 gitignore，不会进仓库）
#
#   cp scripts/e2e/e2e.env.example .workbuddy/e2e.env
#
# 也可以直接用同名环境变量覆盖（环境变量优先级更高）。

# 测试账号（必填）—— 必须是**专用测试账号**，别用你日常调试用的账号。
# 原因：你的日常 Chrome 里装着开发版扩展，它会登录同一账号在后台同步，
# 随时把 E2E 的「干净起跑线」写脏（实测踩到过：1 分钟内云端从 0 个空间变成 2 个）。
# 本项目专用账号：bsync-e2e@example.com（建号：node scripts/e2e/create-account.mjs）
E2E_EMAIL=bsync-e2e@example.com
E2E_PASSWORD=

# 口令门禁用的口令（可选，≥8 字符）。
# ⚠ 注意：跑 phrase-gate 场景需要「云端无盐 + 无 op」的干净起点（--fresh 会复位）。
#    复位后账号的 E2EE 盐会被清掉 —— 之后用新口令派生出的密钥解不开**旧口令加密的
#    历史数据**。所以这个口令只用于测试账号，别填你真实数据在用的口令。
E2E_PASSPHRASE=bsync-e2e-passphrase-2026

# 可选：扩展产物目录（默认 <repo>/extension）
# EXT_DIR=
# 可选：profile 根目录（默认 <repo>/scripts/e2e/.profiles）
# PROFILE_DIR=
# 可选：Chrome 二进制（默认自动探测）
# CHROME_BIN=
# 可选：0 = 有头（看它自己点），默认 1 无头
# E2E_HEADLESS=1
# 可选：1 = 跑完保留 profile，便于复现现场
# E2E_KEEP_PROFILES=0
# 可选：每个场景保留最近多少份 JSON 报告（默认 5，旧报告自动裁掉，0 = 不裁）
# E2E_KEEP_REPORTS=5
